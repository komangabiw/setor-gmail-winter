# Token bot Telegram. Ambil dari @BotFather lalu isi di .env.local
TELEGRAM_BOT_TOKEN=

# Chat id channel tujuan laporan (opsional, default: -1003715736899)
TELEGRAM_CHAT_ID=-1003715736899

# Configuration Supabase Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configuration Google OAuth Direct
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://setorgmail.com
